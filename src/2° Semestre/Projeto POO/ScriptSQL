create database trabalho_poo;

create user joao identified by '123';
grant all privileges on trabalho_poo.* to joao;

-- Criando a tabela Localidade
select * from localidade;
CREATE TABLE Localidade (
    cep long,
    estado VARCHAR(100),
    cidade VARCHAR(100),
    bairro VARCHAR(100),
    logradouro VARCHAR(200)
);


-- Criando a tabela Telefone
drop table telefone;
select * from telefone;
CREATE TABLE Telefone (
    id INT AUTO_INCREMENT PRIMARY KEY,
    numero VARCHAR(20),
    tipo VARCHAR(20)
);

-- Criando a tabela PessoaFisica
drop table pessoafisica;
select * from pessoafisica;
CREATE TABLE PessoaFisica (
    cpf VARCHAR(11),
    nome VARCHAR(100),
    dtNasc DATE,
    sexo varchar(45)
);

-- Criando a tabela PessoaJuridica
select * from pessoaJuridica;
drop table pessoaJuridica;
CREATE TABLE PessoaJuridica (
    cnpj VARCHAR(14),
    razaoSocial VARCHAR(200),
    inscEstadual VARCHAR(20),
    nomeFantasia VARCHAR(100)
);

-- Criando a tabela PessoaJuridica
select * from banco;
drop table banco;
CREATE TABLE banco (
    codigo long,
    nome VARCHAR(200),
    mascaraAgencia VARCHAR(20),
    mascaraConta VARCHAR(100)
);

select * from evento;
drop table evento;
CREATE TABLE evento (
    id long,
    descricao VARCHAR(200),
    tipoMovimentacao VARCHAR(20),
    situacao VARCHAR(100)
);

select * from cotacoes;
drop table cotacoes;
CREATE TABLE cotacoes (
    codigo long,
    `data` date,
    valor DECIMAL(9,2)
);

select * from indiceRemuneracao;
drop table indiceRemuneracao;
CREATE TABLE indiceRemuneracao(
    codigo long,
    descricao VARCHAR(100),
    periodicidade VARCHAR(100),
    situacao VARCHAR(100)
);


select * from conta_poupanca;
drop table conta_poupanca;
CREATE TABLE conta_poupanca (
    id INT PRIMARY KEY AUTO_INCREMENT,
    codigo_banco INT NOT NULL,
    agencia INT NOT NULL,
    numero INT NOT NULL,
    saldo DOUBLE NOT NULL,
    data_abertura DATE NOT NULL,
    titular VARCHAR(255) NOT NULL,
    indice_remuneracao_id BIGINT NOT NULL,
    aniversario DATE NOT NULL,
    perc_rendimento_real DOUBLE NOT NULL
);
